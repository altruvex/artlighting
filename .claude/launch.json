{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "admin",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "admin-3002",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "admin",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "--port",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "web-3010",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "--port",
        "3010"
      ],
      "port": 3010
    }
