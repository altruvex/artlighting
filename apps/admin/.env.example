# ─── Better Auth ─────────────────────────────────────────────
# Signs session cookies. REQUIRED in production, at least 32 characters.
# Generate with: openssl rand -base64 32
# Use a DIFFERENT value for apps/web and apps/admin (separate identity pools).
BETTER_AUTH_SECRET=

# Public base URL of this app (used for auth callbacks/redirects),
# e.g. http://localhost:3001 in development.
BETTER_AUTH_URL=
