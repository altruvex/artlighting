# apps/admin — admin dashboard. Copy to .env and fill in. Never commit .env.
# Validated at server start by env.ts ("core" vars block production boot).

# ─── Database (Neon) ─────────────────────────────────────────
# Pooled connection string (host contains "-pooler"). Use the Neon `dev`
# branch locally, never production.
DATABASE_URL=

# ─── Better Auth (admins/staff) ──────────────────────────────
# Signs session cookies. REQUIRED in production, at least 32 characters.
# Generate with: openssl rand -base64 32
# Use a DIFFERENT value from apps/web (separate identity pools).
BETTER_AUTH_SECRET=
# Public base URL of THIS admin app for auth callbacks/redirects.
BETTER_AUTH_URL=http://localhost:3001

# Public URL of the STOREFRONT (apps/web), sent as the allowed CORS origin
# on this app's /api routes. Optional.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Same value as apps/web's STOREFRONT_REVALIDATE_SECRET. After every product,
# price, stock or discount write, this app tells the storefront to drop its
# cache (lib/storefront.ts); without it, changes show there within 5 minutes.
# Generate with: openssl rand -hex 32
STOREFRONT_REVALIDATE_SECRET=

# ─── Cloudinary (product images) ─────────────────────────────
# Cloudinary console → Settings → API Keys. Server-side only.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# ─── Datasheet worker (PPTX -> PDF, bulk jobs) ───────────────
# Base URL of apps/datasheet-worker, e.g. http://localhost:8080 when run
# with Docker locally.
DATASHEET_WORKER_URL=http://localhost:8080
# Shared secret sent as x-datasheet-worker-secret. Must equal the worker's
# DATASHEET_WORKER_SECRET. At least 32 characters: openssl rand -base64 32
DATASHEET_WORKER_SECRET=
