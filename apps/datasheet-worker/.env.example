# apps/datasheet-worker — PPTX -> PDF conversion and bulk datasheet jobs.
# Pass these to the container (docker run --env-file / host env settings).

# Port the HTTP server listens on.
PORT=8080

# Shared secret expected in the x-datasheet-worker-secret header. Must equal
# apps/admin's DATASHEET_WORKER_SECRET. The worker rejects every request
# when this is unset. At least 32 characters: openssl rand -base64 32
DATASHEET_WORKER_SECRET=

# Neon pooled connection string (bulk jobs read products). Use the `dev`
# branch locally.
DATABASE_URL=

# Base URL product images are fetched from (relative /public paths).
STOREFRONT_BASE_URL=https://www.artlighting-eg.com

# LibreOffice binary. The Docker image puts `soffice` on PATH.
SOFFICE_BIN=soffice

# Bulk job tuning: products rendered in parallel, and parallel PPTX->PDF
# conversions (LibreOffice is heavy; keep this at 1 on small instances).
BULK_CONCURRENCY=3
BULK_CONVERSION_CONCURRENCY=1
