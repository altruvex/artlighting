# apps/web — storefront. Copy to .env and fill in. Never commit .env.
# Validated at server start by src/env.ts ("core" vars block production boot).

# ─── Database (Neon) ─────────────────────────────────────────
# Pooled connection string (host contains "-pooler"). Use the Neon `dev`
# branch locally, never production.
DATABASE_URL=

# ─── Better Auth (customers) ─────────────────────────────────
# Signs session cookies. REQUIRED in production, at least 32 characters.
# Generate with: openssl rand -base64 32
# Use a DIFFERENT value from apps/admin (separate identity pools).
BETTER_AUTH_SECRET=
# Public base URL of this app for auth callbacks/redirects.
# Optional: falls back to NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# ─── URLs ────────────────────────────────────────────────────
# Public URL of the storefront (CORS, auth fallback, and the origin of every
# canonical, hreflang and sitemap URL). In production this must be the host
# that serves pages without redirecting: https://artlighting-eg.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL of the admin app (allowed CORS origin). Optional.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ─── Upstash Redis (cache + rate limiting) ───────────────────
# The database's rediss:// URL from the Upstash console. It wins over the
# REST pair below, which is only needed when REDIS_URL is not set.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Email (Resend) ──────────────────────────────────────────
# API key from resend.com → API Keys. Without it, order and account emails
# are logged instead of sent.
RESEND_API_KEY=
# Sender. Must be on a domain verified in Resend (resend.com → Domains);
# until one is, Resend only delivers to the account owner's own address.
EMAIL_FROM="Art Lighting <orders@artlighting-eg.com>"
# Where a copy of every order goes. Comma-separate for more than one.
ORDER_NOTIFY_EMAIL=artlighting10@gmail.com

# Shared with apps/admin (same value in both). The admin calls
# /api/revalidate with it after every catalogue write so the cached
# products, prices and promotions refresh at once; without it they refresh
# within 5 minutes. Generate with: openssl rand -hex 32
STOREFRONT_REVALIDATE_SECRET=

# Gzip in Node. Leave unset (on) when Node talks to browsers directly. Set
# to "off" when a CDN or nginx in front compresses: in a load test that
# raised throughput from ~122 to ~203 requests/s. Ignored on Vercel.
NEXT_COMPRESS=
# Self-hosted with more than one instance: with Redis configured above
# set, cache invalidations are shared between instances through Redis
# (cache-handler.cjs). "off" opts out. Not used on Vercel.
SHARED_CACHE_TAGS=
