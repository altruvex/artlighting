# packages/database — Prisma CLI (migrations, studio, scripts).
# Point these at the Neon `dev` branch locally, NEVER at production.

# Pooled connection string (host contains "-pooler"), used at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string, used by `prisma migrate`.
DIRECT_URL=

# scripts/seed-admin.ts — bootstraps the first admin (owner) account.
# BETTER_AUTH_SECRET must match apps/admin's value.
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
