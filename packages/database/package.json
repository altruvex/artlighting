{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "migrate:variants-images": "tsx scripts/migrate-product-variants-images.ts",
    "validate:json": "tsx ./scripts/validate-json-consistency.ts",
    "fix:json": "tsx ./scripts/fix-json-files.ts",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "catalog:",
    "@prisma/client": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./index.ts",
    "./browser": "./generated/prisma/browser.ts"
  }
}
