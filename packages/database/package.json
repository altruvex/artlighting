{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx seed.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "migrate:variants-images": "tsx scripts/migrate-product-variants-images.ts",
    "db:reset": "prisma migrate reset --force",
    "import:products": "tsx ./scripts/import-products.ts",
    "import:products:debug": "DEBUG=1 tsx ./scripts/import-products.ts",
    "validate:json": "tsx ./scripts/validate-json-consistency.ts",
    "fix:json": "tsx ./scripts/fix-json-files.ts",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "better-auth": "catalog:",
    "dotenv": "^17.4.2",
    "dotenv-flow": "^4.1.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prisma": "^6.19.3",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
