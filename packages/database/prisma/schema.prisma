// Prisma 7: the client is generated into ../generated/prisma (gitignored)
// and re-exported by packages/database/index.ts. Connection URLs live in
// prisma.config.ts (migrations) and index.ts (runtime driver adapter).
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Inventory ───────────────────────────────────────────────
// Stock used to be a single Int on ProductVariant. A number with no history
// cannot answer the questions an ERP is for: why did it change, who changed
// it, what is promised to an order that has not shipped, and what can a
// customer still buy. These four models answer those.

/// Where stock physically sits. One row today, but a quantity that cannot
/// say *where* it is cannot survive a second warehouse or a showroom.
model InventoryLocation {
  id        String   @id @default(cuid())
  /// Stable and language-neutral, e.g. "main".
  code      String   @unique
  /// Fallback name; the translations carry what the admin actually sees.
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        InventoryItem[]
  translations InventoryLocationTranslation[]

  @@index([isActive])
  @@map("inventory_locations")
}

model InventoryLocationTranslation {
  id         String @id @default(cuid())
  locationId String
  language   String
  name       String

  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, language])
  @@index([language])
  @@map("inventory_location_translations")
}

/// The stock of one variant at one location.
model InventoryItem {
  id         String @id @default(cuid())
  variantId  String
  locationId String

  /// Physically present, including whatever is reserved.
  onHand   Int @default(0)
  /// Promised to orders that have not shipped yet. Kept separate from
  /// onHand because the units are still in the building: a stock count
  /// must match onHand, not what is sellable.
  reserved Int @default(0)
  /// On a purchase order and not yet arrived. Informational — it is not
  /// sellable and never counts towards onHand.
  incoming Int @default(0)

  /// Below this, the admin flags the row. Null falls back to the product's
  /// lowStockThreshold.
  reorderPoint    Int?
  /// How many to order when it drops, so a reorder is one click and not a
  /// judgement call every time.
  reorderQuantity Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location  InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  // Available to sell is `onHand - reserved`, computed on read and never
  // stored: a stored copy is one more number that can disagree with the
  // two it is derived from.
  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
  @@map("inventory_items")
}

/// Why stock moved. Append-only: a row is never updated and never deleted,
/// because the point of a ledger is that it still says what it said.
enum StockMovementKind {
  /// Arrived from a supplier.
  RECEIPT
  /// Left with a customer order.
  SALE
  /// Came back from a customer.
  RETURN
  /// A stock count disagreed with the system, and the count won.
  ADJUSTMENT
  /// Promised to an order that has not shipped.
  RESERVE
  /// A reservation that will not be fulfilled after all.
  RELEASE
  TRANSFER_IN
  TRANSFER_OUT
}

model StockMovement {
  id     String            @id @default(cuid())
  itemId String
  kind   StockMovementKind

  /// Signed: +10 for a receipt, -3 for a sale. Signed rather than positive
  /// with the sign implied by `kind`, so a running total is a plain SUM and
  /// cannot be got wrong by forgetting a case.
  quantity      Int
  /// What onHand became after this movement. Stored so one row explains
  /// itself without replaying the ledger from the beginning.
  onHandAfter   Int
  /// What reserved became. A RESERVE moves this, not onHand — the units
  /// have not left the building yet.
  reservedAfter Int

  /// Free text for an ADJUSTMENT ("annual count", "damaged in transit").
  reason  String?
  /// The order that caused a SALE, RESERVE, RELEASE or RETURN.
  orderId Int?
  /// The admin who did it, or "system" for anything the app did on its own.
  actorId String?

  createdAt DateTime @default(now())

  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([itemId, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([kind])
  @@map("stock_movements")
}

// ─── Configuration ──────────────────────────────────────────
model Configuration {
  id                String    @id @default(cuid())
  productId         String
  /// Owner, once a signed-in customer touches it. Null while the visitor is
  /// anonymous; a guest row can only be claimed by the browser that created
  /// it (guestToken below), and after that only that customer may change it.
  userId            String?
  /// Random per-browser token from the guest_id cookie, recorded when the
  /// configuration is created anonymously. cuid ids carry a sequential
  /// counter and a per-process constant, so they are not a secret — this is
  /// what actually binds an anonymous configuration to its visitor.
  guestToken        String?
  configPrice       Decimal   @db.Decimal(12, 2)
  priceIncrease     Decimal   @default(0) @db.Decimal(12, 2)
  shippingPrice     Decimal   @default(0) @db.Decimal(12, 2)
  discount          Decimal   @default(0) @db.Decimal(5, 4)
  quantity          Int       @default(1)
  /// What the chosen bulbs add: the bulb's price times the number of arms.
  lampPriceIncrease Decimal?  @default(0) @db.Decimal(12, 2)
  /// Which bulb that was. The amount alone could not say, so a price change
  /// left every past configuration unreadable.
  bulbId            String?
  totalPrice        Decimal   @db.Decimal(12, 2)
  currency          String    @default("EGP")
  productIp         ProductIP @default(IP20)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders     Order[]     @relation("ConfigurationToOrder")
  orderItems OrderItem[]
  user       User?       @relation("ConfigurationOwner", fields: [userId], references: [id], onDelete: SetNull)
  // SetNull, not Cascade: retiring a bulb must not delete the carts that
  // chose it. lampPriceIncrease keeps what it cost.
  bulb       Bulb?       @relation(fields: [bulbId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([bulbId])
  @@index([productId, updatedAt(sort: Desc)], name: "idx_configuration_product_updated")
  @@index([userId])
  @@index([guestToken])
  @@map("configurations")
}

// ─── User ────────────────────────────────────────────────────
// Doubles as the Better Auth "user" model (name/email/emailVerified/image are
// Better Auth's required fields) so customer identity and the existing
// e-commerce profile live in one table instead of two linked ones.
model User {
  id                String   @id @default(cuid())
  name              String   @default("")
  email             String   @unique
  emailVerified     Boolean  @default(false)
  image             String?
  phoneNumber       String?
  role              UserRole @default(CUSTOMER)
  preferredLanguage String   @default("ar")
  preferredCurrency String   @default("EGP")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  shippingAddressId String?  @unique

  shippingAddress     ShippingAddress?
  configurations      Configuration[]      @relation("ConfigurationOwner")
  cart                Cart?
  orders              Order[]
  sessions            Session[]
  accounts            Account[]
  discountRedemptions DiscountRedemption[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ─── OrderItem ───────────────────────────────────────────────
model OrderItem {
  id               String  @id @default(cuid())
  orderId          Int
  productId        String
  productVariantId String?
  quantity         Int
  /// One unit as configured — the product's price plus the wattage, IP and
  /// bulb upgrades the customer chose — before any discount.
  configPrice      Decimal @db.Decimal(12, 2)
  configurationId  String?
  localizedName    String?

  /// Snapshots, taken when the order is placed. Copies and not relations:
  /// an invoice must still show what was bought after the product is
  /// renamed, re-photographed or repriced.
  productName      String   @default("")
  productImages    String[] @default([])
  brand            String?
  productIp        String?
  productColorTemp String?
  /// SetNull, like Order.bulbId: retiring a bulb must not delete a line.
  bulbId           String?

  /// What the discounts took off this line, and what it came to after
  /// them. lineTotal = configPrice × quantity − discountAmount.
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @default(0) @db.Decimal(12, 2)

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [productVariantId], references: [id])
  configuration Configuration?  @relation(fields: [configurationId], references: [id])
  bulb          Bulb?           @relation(fields: [bulbId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@map("order_items")
}

// ─── Order ───────────────────────────────────────────────────
model Order {
  id                     Int         @id @default(autoincrement())
  userId                 String
  /// The single-product columns below predate order lines. Orders placed
  /// from now on leave them empty and keep their products in orderItems;
  /// older orders were copied into orderItems when lines were introduced.
  productId              String?
  productName            String?
  /// A snapshot taken when the order was placed. Deliberately a copy, not a
  /// relation: an invoice must still show what the customer actually bought
  /// after the product's images are replaced.
  productImages          String[]
  productColorTemp       String?
  productIp              String?
  /// Which bulb the fixture was bought with. A relation and not a string:
  /// the name is translated, and a receipt has to render in either language
  /// years later. productChandLamp below is the string this replaces — it
  /// only ever held the product's unused default, so every order said 9 W
  /// whatever the customer picked and paid for.
  bulbId                 String?
  productChandLamp       String?
  quantity               Int?
  isCompleted            Boolean     @default(false)
  status                 OrderStatus @default(awaiting_shipment)
  currency               String      @default("EGP")
  customerLanguage       String      @default("ar")
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  productPrice           Decimal?    @db.Decimal(12, 2)
  discountedPrice        Decimal?    @db.Decimal(12, 2)
  discountApplied        Boolean     @default(false)
  discountRate           Decimal     @default(0) @db.Decimal(5, 4)
  /// Everything the customer pays: subtotal − discountTotal + shippingPrice.
  totalPrice             Decimal     @db.Decimal(12, 2)
  configPrice            Decimal?    @db.Decimal(12, 2)
  /// The lines before discounts, and what the discounts took off them.
  subtotal               Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal          Decimal     @default(0) @db.Decimal(12, 2)
  priceIncrease          Decimal     @default(0) @db.Decimal(12, 2)
  shippingPrice          Decimal     @default(0) @db.Decimal(12, 2)
  brand                  String?
  chandelierLightingType String?
  orderTimeReceived      DateTime?
  configurationId        String?
  shippingAddressId      String?

  orderItems          OrderItem[]
  stockMovements      StockMovement[]
  // Restrict, as it was while the column was required: making it optional
  // must not quietly turn a product delete into orders that forget it.
  product             Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  shippingAddress     ShippingAddress?     @relation(fields: [shippingAddressId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  configuration       Configuration?       @relation("ConfigurationToOrder", fields: [configurationId], references: [id])
  discountRedemptions DiscountRedemption[]
  // SetNull, said out loud: retiring a bulb must not delete an invoice.
  bulb                Bulb?                @relation(fields: [bulbId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([isCompleted])
  @@index([userId, createdAt(sort: Desc)], name: "idx_order_user_created")
  @@index([status, createdAt(sort: Desc)], name: "idx_order_status_created")
  @@index([isCompleted, createdAt(sort: Desc)], name: "idx_order_completed_created")
  @@map("orders")
}

// ─── ShippingAddress ─────────────────────────────────────────
model ShippingAddress {
  id          String  @id @default(cuid())
  userId      String  @unique
  fullName    String
  address     String
  city        String
  state       String
  zipCode     String
  country     String
  countryCode String  @default("EG")
  phoneNumber String
  isDefault   Boolean @default(false)

  orders Order[]
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shipping_addresses")
}

// ─── Cart ────────────────────────────────────────────────────
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  currency  String   @default("EGP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ─── Product ─────────────────────────────────────────────────
// Source of truth: products-details-static.json
// maxIP          → static.MaxIP     (maximum IP rating available, e.g. 65 means can go up to IP65)
// spotlightType  → static.spotlightType  (cob / track-light / panel-light / mc15c / etc.)
// sectionType    → static.sectionType    (indoor / outdoor / chandelier)
// brand          → static.brand          (balcom / mister-led)
// hNumber        → static.Hnumber        (number of lamp heads for chandeliers)
// chandelierLightingType → static.chandelierLightingType (LED / lamp)
model Product {
  id                     String           @id @default(cuid())
  productId              String           @unique // e.g. "jy-202-15w"
  productName            String
  specSheetUrl           String? // downloadable PDF datasheet — URL-based, same rationale as ProductImage (no storage provider chosen yet)
  maxIP                  Int? // Max IP rating integer (20/44/54/65/68)
  spotlightType          String // e.g. "cob", "track-light", "mc15c"
  price                  Decimal          @db.Decimal(12, 2)
  /// The "was" price shown struck through. Display only: it is never charged.
  compareAtPrice         Decimal?         @db.Decimal(12, 2)
  /// What the product costs us. Feeds the margin figure in the admin; never
  /// leaves the admin and is never sent to the storefront.
  cost                   Decimal?         @db.Decimal(12, 2)
  priceIncrease          Decimal          @default(0) @db.Decimal(12, 2)
  /// The broad shelf this product sits on. The URL segment is derived
  /// from it (see FAMILY_SLUGS in @repo/catalog), not equal to it.
  sectionType            ProductFamily
  brand                  String // "balcom" | "mister-led"
  chandelierLightingType String? // "LED" | "lamp"
  hNumber                Int? // Number of heads/lights (chandeliers)
  isActive               Boolean          @default(true)
  /// Replaces the isActive/deletedAt pair as the single lifecycle field.
  /// Backfilled from them; both are kept in step until the storefront and
  /// admin read `status`, then they go in their own migration.
  status                 ProductStatus    @default(ACTIVE)
  /// Below this, the admin list flags the row. Per product, because a
  /// chandelier and a 5W spotlight do not restock at the same pace.
  lowStockThreshold      Int              @default(5)
  featured               Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime? // soft-delete: never hard-delete, historical orders reference products
  categoryId             String
  lightingtypeId         String
  productColor           ProductColorTemp @default(warm)
  productIp              ProductIP        @default(IP20) // Base IP enum derived from EN specs
  productChandLamp       ProductChandLamp @default(lamp9w)

  cartItems         CartItem[]
  orders            Order[]
  orderItems        OrderItem[]
  category          Category               @relation("ProductTopCategory", fields: [categoryId], references: [id])
  lightingtype      Category               @relation("ProductSubCategory", fields: [lightingtypeId], references: [id])
  specifications    ProductSpecification[]
  specGroups        SpecGroup[]
  translations      ProductTranslation[]
  variants          ProductVariant[]
  images            ProductImage[]
  productCategories ProductCategory[]
  discounts         DiscountProduct[]
  priceHistory      PriceHistory[]
  bulbs             ProductBulb[]

  @@index([productId])
  @@index([categoryId])
  @@index([lightingtypeId])
  @@index([brand])
  @@index([sectionType])
  @@index([spotlightType])
  @@index([isActive])
  @@index([featured])
  @@index([deletedAt])
  @@index([status])
  @@index([brand, sectionType, isActive, featured], name: "idx_product_brand_section_active_featured")
  @@index([brand, sectionType, spotlightType, isActive], name: "idx_product_brand_section_spotlight_active")
  @@map("products")
}

// ─── ProductVariant ──────────────────────────────────────────
// New: per-SKU purchasable unit. Every existing product gets exactly one
// default variant at migration time (mirroring its current price/stock/
// colorTemp) since no product currently has more than one purchasable
// configuration — this is additive, existing Product.price/quantity fields
// are untouched so the storefront keeps reading them unchanged.
model ProductVariant {
  id             String            @id @default(cuid())
  productId      String
  sku            String            @unique
  wattage        String?
  colorTemp      ProductColorTemp?
  finish         String?
  size           String?
  /// This variant's own price. Null means "use the product's price".
  price          Decimal?          @db.Decimal(12, 2)
  compareAtPrice Decimal?          @db.Decimal(12, 2)
  cost           Decimal?          @db.Decimal(12, 2)
  isActive       Boolean           @default(true)
  position       Int               @default(0)
  isDefault      Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  inventory  InventoryItem[]

  @@index([productId])
  @@index([productId, position])
  @@map("product_variants")
}

// ─── ProductImage ────────────────────────────────────────────
// New: per-image entity for the admin bulk-upload/reorder/set-primary flow.
// Additive alongside Product.productImages (String[]) — storefront components
// still read the array; only admin writes/reads this table for now. Seeded
// from the same array at migration time.
model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  providerId String? // Cloudinary public_id — needed to delete the asset later; parsing it back out of the URL is fragile, so it's stored directly. Null for images added by pasting an external URL.
  altText    String?
  order      Int      @default(0)
  isPrimary  Boolean  @default(false)
  /// Straight from the Cloudinary upload response, so next/image can be
  /// given real dimensions instead of guessing an aspect ratio.
  width      Int?
  height     Int?
  format     String?
  bytes      Int?
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, order])
  @@map("product_images")
}

// ─── ProductTranslation ──────────────────────────────────────
model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  language    String // "en" | "ar"
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
  @@index([language])
  @@index([productId, language], name: "idx_product_translation_product_language")
  @@map("product_translations")
}

// ─── ProductSpecification ────────────────────────────────────
// Stores the specificationsTable from EN/AR JSON files per language.
// Note: maxIP is NOT stored here — it lives in Product.maxIP.
model ProductSpecification {
  id                 String   @id @default(cuid())
  productId          String
  language           String // "en" | "ar"
  // Balcom (LED spotlights, panels, strips, etc.)
  input              String? // AC voltage / input type
  maximumWattage     String? // watts
  brandOfLed         String? // LED chip brand (Epistar, etc.)
  luminousFlux       String? // lumens (may include /M for strips)
  mainMaterial       String?
  cri                String? // Color Rendering Index
  beamAngle          String?
  workingTemperature String?
  fixtureDimmable    String?
  electrical         String? // driver info
  powerFactor        String?
  colorTemperature   String? // e.g. "3000K / 4000K / 6500K"
  ip                 String? // Base IP as stored in spec (string)
  energySaving       String?
  lifeTime           String?
  // Mister LED chandeliers only
  finish             String? // e.g. "Brushed Nickel"
  lampBase           String? // e.g. "E27"
  bulb               String? // "Yes" | "No"
  // Extra / future use
  customSpecs        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
  @@index([language])
  @@index([productId])
  @@index([productId, language], name: "idx_product_spec_product_language")
  @@map("product_specifications")
}

// ─── Category ────────────────────────────────────────────────
// Two-level hierarchy: top-level rows (parentId null) map to the former
// sectionType ("indoor" | "outdoor" | "chandelier"); child rows (parentId set)
// map to the former LightingType / spotlightType ("cob", "track-light", etc.),
// folded in here 2026-08 — confirmed 1:1 (every LightingType belonged to
// exactly one Category) before merging, so no product needed multi-parent support.
// Product.categoryId keeps pointing at the top-level row and Product.lightingtypeId
// (relation name "lightingtype", kept for zero call-site churn) now points at the
// child row here instead of the old LightingType table — both are plain Category
// rows post-merge. ProductCategory below is the new, genuinely many-to-many surface.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  parentId  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent            Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children          Category[]            @relation("CategoryHierarchy")
  products          Product[]             @relation("ProductTopCategory")
  subProducts       Product[]             @relation("ProductSubCategory")
  productCategories ProductCategory[]
  translations      CategoryTranslation[]
  discounts         DiscountCategory[]

  @@index([isActive])
  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  language    String
  name        String
  description String?
  metaTitle   String?
  metaDesc    String?
  slug        String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
  @@unique([language, slug])
  @@index([language])
  @@index([categoryId, language], name: "idx_category_translation_category_language")
  @@map("category_translations")
}

// ─── ProductCategory ─────────────────────────────────────────
// Genuinely many-to-many product/category membership, additive to the
// legacy Product.categoryId / Product.lightingtypeId direct FKs below
// (kept so apps/web/src/lib/i18n/services.ts and the /category/* route
// tree don't need to change). New admin category tagging should use this.
model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

// ─── Discount ────────────────────────────────────────────────
model Discount {
  id   String @id @default(cuid())
  /// What the admin calls it. Shown in the list, on the order and on an
  /// invoice line, so it is not optional.
  name String

  type  DiscountType
  mode  DiscountMode
  scope DiscountScope

  /// FIXED only: an amount off. Null for a percentage.
  amount Decimal? @db.Decimal(12, 2)
  /// PERCENTAGE only: a **rate**, 0.1300 = 13%, the same convention as
  /// every other rate in this schema. Deliberately a separate column from
  /// `amount`: one column whose meaning depends on another column's value
  /// is how a cart came to charge 0.13% instead of 13%. A CHECK constraint
  /// enforces that exactly the right one is set.
  rate   Decimal? @db.Decimal(5, 4)

  /// Upper-cased on write and unique, so lookup is case-insensitive without
  /// a function index. Required for COUPON, forbidden for AUTOMATIC.
  code String? @unique

  /// The cart must reach this before the discount applies.
  minOrderValue Decimal? @db.Decimal(12, 2)

  /// Total redemptions allowed across all customers; null is unlimited.
  usageLimit       Int?
  /// Redemptions allowed per customer; null is unlimited.
  perCustomerLimit Int?
  /// Maintained under a row lock at checkout, so concurrent orders cannot
  /// push it past usageLimit.
  usageCount       Int  @default(0)

  /// Whether this can combine with others. Non-stackable discounts compete
  /// and the best one for the customer wins.
  stackable Boolean @default(false)
  /// Order in which stackable discounts apply. Lower runs first.
  priority  Int     @default(0)

  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products    DiscountProduct[]
  categories  DiscountCategory[]
  families    DiscountFamily[]
  redemptions DiscountRedemption[]

  @@index([scope])
  @@index([mode])
  @@index([code])
  @@index([isActive, startsAt, endsAt])
  @@map("discounts")
}

/// Which products a PRODUCTS-scoped discount covers. A join table rather
/// than a single productId: a promotion almost never covers exactly one
/// product, and the old shape forced one Discount row per product.
model DiscountProduct {
  discountId String
  productId  String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
  @@map("discount_products")
}

model DiscountCategory {
  discountId String
  categoryId String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([categoryId])
  @@map("discount_categories")
}

/// One use of a discount on one order. This is what enforces the usage
/// limits, and what answers "what did this promotion actually cost us".
/// Which families a FAMILIES-scoped discount covers.
model DiscountFamily {
  discountId String
  family     ProductFamily

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([discountId, family])
  @@index([family])
  @@map("discount_families")
}

model DiscountRedemption {
  id            String   @id @default(cuid())
  discountId    String
  orderId       Int
  /// Null for a guest checkout; the email is kept either way so a
  /// per-customer limit still means something without an account.
  userId        String?
  customerEmail String
  /// What this discount took off this order, in money.
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// A discount cannot be redeemed twice on the same order.
  @@unique([discountId, orderId])
  @@index([discountId, userId])
  @@index([discountId, customerEmail])
  @@index([orderId])
  @@map("discount_redemptions")
}

// ─── PriceHistory ────────────────────────────────────────────
// Written automatically by a Prisma Client extension (see packages/database/index.ts)
// on every Product.price update — never written to manually by admin code.
model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  oldPrice  Decimal  @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  changedBy String // Admin.id, or "system" for non-admin-initiated changes
  changedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([changedAt(sort: Desc)])
  @@map("price_history")
}

// ─── Admin ───────────────────────────────────────────────────
// Better Auth's "user" model for the admin app — a separate identity pool
// from the customer-facing User/Session/Account/Verification above (own
// tables via modelName mapping in apps/admin's auth config), so admin and
// customer sessions/credentials never share a table.
model Admin {
  id            String    @id @default(cuid())
  name          String    @default("")
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          AdminRole @default(STAFF)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions AdminSession[]
  accounts AdminAccount[]

  @@map("admins")
}

model AdminSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  adminId   String

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model AdminAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  adminId               String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_accounts")
}

model AdminVerification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("admin_verifications")
}

// ─── System / Config ─────────────────────────────────────────
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model CurrencyRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(18, 8)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
  @@index([isActive])
  @@map("currency_rates")
}

// ─── Enums ───────────────────────────────────────────────────
/// Structured, localized, grouped specifications. Replaces the fixed
/// columns of ProductSpecification, which cannot describe a product whose
/// datasheet has a spec the columns do not name. The old table stays until
/// the datasheet worker and the storefront read these, then it is dropped.
model SpecGroup {
  id        String   @id @default(cuid())
  productId String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  items        SpecItem[]
  translations SpecGroupTranslation[]

  @@index([productId])
  @@index([productId, position])
  @@map("spec_groups")
}

model SpecGroupTranslation {
  id       String @id @default(cuid())
  groupId  String
  language String
  name     String

  group SpecGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, language])
  @@index([language])
  @@map("spec_group_translations")
}

model SpecItem {
  id         String         @id @default(cuid())
  groupId    String
  position   Int            @default(0)
  /// Language-neutral name for *which* spec this is ("luminousFlux", "ip").
  /// Without it a spec can only be found by its translated label or by its
  /// position, which is how the storefront came to look up "Energy Saving"
  /// by an English string and find nothing at all on the Arabic page.
  key        String?
  /// Language-neutral, so "15" + "W" reads correctly in both locales.
  unit       String?
  /// What sort of value this is, which decides how it renders and what it
  /// is stored in. The whole point of the split: a figure is a number, not
  /// a sentence someone typed twice.
  kind       SpecValueKind  @default(TEXT)
  /// "≥ 80" is a comparator and a number, not the string "≥ 80".
  comparator SpecComparator @default(EXACT)
  /// CHOICE only: which entry of the shared vocabulary this is.
  optionId   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  group        SpecGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  option       SpecOption?           @relation(fields: [optionId], references: [id], onDelete: SetNull)
  measurements SpecMeasurement[]
  translations SpecItemTranslation[]

  @@index([groupId])
  @@index([groupId, position])
  @@index([optionId])
  @@index([key])
  @@map("spec_items")
}

/// One figure. A spec can carry several — luminous flux is measured once per
/// colour temperature, which is why "1320LM (3000k) / 1400LM (6500k)" was a
/// single hand-typed string before, and why it disagreed with its own Arabic.
model SpecMeasurement {
  id             String   @id @default(cuid())
  itemId         String
  position       Int      @default(0)
  value          Decimal  @db.Decimal(14, 4)
  /// Set only for a RANGE: -10 .. 45 °C.
  valueMax       Decimal? @db.Decimal(14, 4)
  /// What this figure was measured at, e.g. 3000 K. Unit kept beside it
  /// because the condition's unit is rarely the measurement's.
  conditionValue Decimal? @db.Decimal(14, 4)
  conditionUnit  String?

  item SpecItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, position])
  @@map("spec_measurements")
}

/// A shared vocabulary for the values that are a choice, not a number:
/// material, driver, lamp base, finish. Defined once and translated once, so
/// "Die-Casting Aluminum" and "ألمنيوم مصبوب بالقالب" are two renderings of
/// one fact instead of two independently editable strings.
/// A bulb the showroom fits into a chandelier that has arms.
///
/// `price` is per bulb; lighting a fixture costs it times the number of
/// arms. This is a row and not a constant because the prices move — they
/// were hard-coded in two places, and the copy inside the component had
/// already drifted from the one beside it.
model Bulb {
  id        String   @id @default(cuid())
  /// Language-neutral and stable, e.g. "candle_3w".
  key       String   @unique
  /// The figure, not a string. "٣" and "3" are the same bulb, and a number
  /// is the only form both languages can render from.
  wattage   Int
  /// The socket it screws into. E27 is the ordinary large screw; E14 is
  /// what a candle bulb — a "بلحة" — uses.
  base      BulbBase @default(E27)
  /// Per bulb.
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations   BulbTranslation[]
  products       ProductBulb[]
  configurations Configuration[]
  orders         Order[]
  orderItems     OrderItem[]

  @@index([isActive, position])
  @@map("bulbs")
}

model BulbTranslation {
  id       String @id @default(cuid())
  bulbId   String
  language String
  /// The shape only: "Candle", "بلحة". The wattage sits beside it as a
  /// number, so the two languages cannot come to disagree about it — the
  /// way the spec rows did.
  name     String

  bulb Bulb @relation(fields: [bulbId], references: [id], onDelete: Cascade)

  @@unique([bulbId, language])
  @@index([language])
  @@map("bulb_translations")
}

/// Which bulbs fit a given chandelier, and which one it is sold with.
///
/// A fixture with arms must be sold with a bulb, so exactly one row per
/// product carries `isDefault` — enforced by a partial unique index, since
/// two defaults would make the price depend on row order.
model ProductBulb {
  productId String
  bulbId    String
  isDefault Boolean @default(false)
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  bulb    Bulb    @relation(fields: [bulbId], references: [id], onDelete: Cascade)

  @@id([productId, bulbId])
  @@index([bulbId])
  @@map("product_bulbs")
}

model SpecOption {
  id        String   @id @default(cuid())
  /// Language-neutral and stable, e.g. "die_cast_aluminium".
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        SpecItem[]
  translations SpecOptionTranslation[]

  @@map("spec_options")
}

model SpecOptionTranslation {
  id       String @id @default(cuid())
  optionId String
  language String
  label    String

  option SpecOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, language])
  @@index([language])
  @@map("spec_option_translations")
}

model SpecItemTranslation {
  id       String  @id @default(cuid())
  itemId   String
  language String
  label    String
  /// Only a TEXT item stores its value here. Everything else renders from
  /// the measurements or the shared option, so the two languages cannot
  /// drift apart.
  value    String?

  item SpecItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, language])
  @@index([language])
  @@map("spec_item_translations")
}

/// How a spec value is stored, and therefore how it renders.
enum SpecValueKind {
  /// One or more numbers with a unit, optionally one per condition.
  MEASUREMENT
  /// A minimum and a maximum with a unit.
  RANGE
  /// An entry from the shared SpecOption vocabulary.
  CHOICE
  /// Genuinely free text. Last resort: it is the only kind that can differ
  /// between languages, so anything stored here is a translation risk.
  TEXT
}

enum SpecComparator {
  EXACT
  AT_LEAST
  AT_MOST
  APPROX
}

/// DRAFT: never shown. ACTIVE: on the storefront. ARCHIVED: hidden, but
/// kept because historical orders reference the product.
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductColorTemp {
  warm // 3000K
  cool // 6500K
  white // 4000K / neutral

  @@map("ProductColorTemp")
}

enum ProductIP {
  IP20
  IP44
  IP54
  IP65
  IP68

  @@map("ProductIP")
}

/// Bulb sockets. E14 is the candle base; the catalogue had only ever
/// recorded E27, which is why nothing in it could tell a "بلحة" chandelier
/// from an ordinary one.
enum BulbBase {
  E27
  E14

  @@map("BulbBase")
}

enum ProductChandLamp {
  lamp9w
  lamp12w

  @@map("ProductChandLamp")
}

enum OrderOption {
  BasicShipping
  StandardShipping
  ExpressShipping

  @@map("OrderOption")
}

enum OrderStatus {
  awaiting_shipment
  processing
  shipped
  delivered
  fulfilled
  cancelled
  refunded

  @@map("OrderStatus")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@map("DiscountType")
}

/// The broad shelf a product sits on, mirroring `Product.sectionType`.
///
/// An enum here and a String there is a seam: `sectionType` should become
/// this type too, in its own migration, and until it does `familyOf()` in
/// @repo/catalog is the single place that maps between them.
enum ProductFamily {
  INDOOR
  OUTDOOR
  CHANDELIER
}

/// AUTOMATIC applies on its own; COUPON needs the customer to type a code.
enum DiscountMode {
  AUTOMATIC
  COUPON
}

enum DiscountScope {
  /// Applies to the lines whose product is listed.
  PRODUCTS
  /// Applies to the lines whose product is in one of the categories.
  CATEGORIES
  /// Applies to the lines whose product is in one of the families —
  /// "every outdoor fixture", which no list of categories expresses as
  /// directly.
  FAMILIES
  /// Applies to the order total rather than to any line.
  CART

  @@map("DiscountScope")
}

enum AdminRole {
  ADMIN
  STAFF

  @@map("AdminRole")
}

/// Customer-side role. Only CUSTOMER today; kept as an enum so tiers
/// (wholesale, contractor) can be added without another type change.
enum UserRole {
  CUSTOMER

  @@map("UserRole")
}
